# No database and no accounts — the app needs no secrets.

# Local development only: path to Chrome/Chromium for PDF export (auto-detected in common locations).
# On Vercel this is ignored and @sparticuz/chromium is used.
# CHROME_EXECUTABLE_PATH="/usr/bin/google-chrome"

# Groq API keys for resume tailoring (server-side only). One or more, comma-separated;
# the next key is used automatically on rate limits / auth errors.
GROQ_API_KEYS=""
# Optional: Groq model id (default: openai/gpt-oss-120b; a retired model is replaced automatically). Must support JSON mode.
# GROQ_MODEL="openai/gpt-oss-120b"
# Optional: OpenAI-compatible base URL override (proxy / gateway)
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
